---
import { experiences } from '../../data/experience';
---
<section id="experience" class="experience-section" aria-labelledby="experience-heading">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal="up">
      <h2 id="experience-heading"><span>03</span> EXPERIENCE</h2>
      <p>THE JOURNEY THAT SHAPED MY WORK</p>
    </div>
    <div class="timeline">
      {experiences.map((entry, i) => (
        <article class="timeline-entry" data-reveal="up" data-reveal-delay={`${Math.min((i % 2) * 75, 80)}`}>
          <div class="timeline-date">{entry.period}</div>
          <div class="timeline-marker" aria-hidden="true"><span></span></div>
          <div class="timeline-info">
            <h3>{entry.position}</h3>
            <h4>{entry.company}</h4>
            {entry.location && <p class="timeline-location">{entry.location}</p>}
            <p class="timeline-desc">{entry.description}</p>
            {entry.tags && <div class="timeline-tags">{entry.tags.slice(0, 4).map(tag => <span>{tag}</span>)}</div>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
