---
import { experiences } from '../../data/experience';
---

<section
  id="experience"
  class="experience"
>
  <div class="experience__container">

    <!-- SECTION HEADER -->

    <div
    class="experience__header"
    data-reveal="up"
    >

      <span class="experience__number">
        02
      </span>

      <div class="experience__line"></div>

      <span class="experience__label">
        Experience
      </span>

    </div>


    <!-- INTRO -->

    <div
    class="experience__intro"
    data-reveal="up"
    >

      <div>

        <p class="experience__eyebrow">
          PROFESSIONAL JOURNEY
        </p>

        <h2 class="experience__title">
          Selected
          <br />
          experience.
        </h2>

      </div>


      <p class="experience__intro-text">
        A journey shaped by people, processes, operations,
        and technology — combining professional experience
        with continuous learning and digital development.
      </p>

    </div>


    <!-- EXPERIENCE LIST -->

    <div class="experience__list">

      {
        experiences.map((experience, index) => (

        <article
            class="experience__item"
            data-reveal="up"
            data-reveal-delay={
            String(
                Math.min(index, 4) * 70
            )
            }
        >

            <!-- NUMBER -->

            <div class="experience__index">

              {String(index + 1).padStart(2, '0')}

            </div>


            <!-- PERIOD -->

            <div class="experience__period">

              <span>
                {experience.period}
              </span>

              {
                experience.location && (
                  <small>
                    {experience.location}
                  </small>
                )
              }

            </div>


            <!-- CONTENT -->

            <div class="experience__content">

              <h3>
                {experience.position}
              </h3>

              <p class="experience__company">
                {experience.company}
              </p>

              <p class="experience__description">
                {experience.description}
              </p>


              {
                experience.responsibilities &&
                experience.responsibilities.length > 0 && (

                <ul class="experience__responsibilities">

                  {
                    experience.responsibilities.map(
                      responsibility => (

                        <li>
                          {responsibility}
                        </li>

                      )
                    )
                  }

                </ul>

              )
              }


              {
                experience.tags &&
                experience.tags.length > 0 && (

                <div class="experience__tags">

                  {
                    experience.tags.map(tag => (

                      <span>
                        {tag}
                      </span>

                    ))
                  }

                </div>

              )
              }

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>


<style>

/* ===================================
   EXPERIENCE
=================================== */

.experience {
  position: relative;

  padding: 130px 0 150px;

  background: #0e1114;

  color: #ffffff;

  overflow: hidden;
}


/* ambient background */

.experience::before {
  content: '';

  position: absolute;

  top: 150px;
  right: -300px;

  width: 650px;
  height: 650px;

  background:
    radial-gradient(
      circle,
      rgba(209, 164, 103, 0.05),
      transparent 70%
    );

  pointer-events: none;
}


/* ===================================
   CONTAINER
=================================== */

.experience__container {
  position: relative;

  z-index: 2;

  width: min(100% - 48px, 1240px);

  margin: 0 auto;
}


/* ===================================
   SECTION HEADER
=================================== */

.experience__header {
  display: flex;
  align-items: center;

  gap: 16px;

  margin-bottom: 85px;
}


.experience__number {
  color: #d1a467;

  font-size: 11px;

  letter-spacing: 0.15em;
}


.experience__line {
  width: 45px;
  height: 1px;

  background:
    rgba(209, 164, 103, 0.65);
}


.experience__label {
  color:
    rgba(255, 255, 255, 0.4);

  font-size: 10px;

  letter-spacing: 0.25em;

  text-transform: uppercase;
}


/* ===================================
   INTRO
=================================== */

.experience__intro {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(300px, 0.65fr);

  align-items: end;

  gap: 100px;

  margin-bottom: 100px;
}


.experience__eyebrow {
  margin-bottom: 20px;

  color: #d1a467;

  font-size: 10px;
  font-weight: 500;

  letter-spacing: 0.3em;
}


.experience__title {
  margin: 0;

  font-family: var(--font-display);

  font-size:
    clamp(55px, 5vw, 80px);

  font-weight: 400;

  line-height: 0.94;

  letter-spacing: -0.04em;

  color: #f8f8f6;
}


.experience__intro-text {
  max-width: 460px;

  padding-bottom: 5px;

  color:
    rgba(255, 255, 255, 0.45);

  font-size: 13px;

  line-height: 1.9;
}


/* ===================================
   EXPERIENCE LIST
=================================== */

.experience__list {
  border-top:
    1px solid rgba(255, 255, 255, 0.11);
}


.experience__item {
  display: grid;

  grid-template-columns:
    65px
    minmax(170px, 0.55fr)
    minmax(0, 1.45fr);

  gap: 45px;

  padding: 55px 0;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.11);

  transition:
    background 0.35s ease,
    padding 0.35s ease;
}


/* subtle hover */

.experience__item:hover {
  padding-left: 18px;
  padding-right: 18px;

  background:
    rgba(255, 255, 255, 0.018);
}


/* ===================================
   INDEX
=================================== */

.experience__index {
  padding-top: 7px;

  color:
    rgba(255, 255, 255, 0.2);

  font-size: 10px;

  letter-spacing: 0.15em;
}


/* ===================================
   PERIOD
=================================== */

.experience__period {
  display: flex;

  flex-direction: column;

  gap: 10px;

  padding-top: 6px;
}


.experience__period span {
  color: #d1a467;

  font-size: 10px;

  letter-spacing: 0.18em;
}


.experience__period small {
  color:
    rgba(255, 255, 255, 0.3);

  font-size: 10px;

  letter-spacing: 0.08em;
}


/* ===================================
   CONTENT
=================================== */

.experience__content h3 {
  margin: 0;

  color: #f8f8f6;

  font-family: var(--font-display);

  font-size:
    clamp(32px, 3vw, 44px);

  font-weight: 400;

  line-height: 1;
}


.experience__company {
  margin-top: 10px;

  color:
    rgba(255, 255, 255, 0.55);

  font-size: 12px;

  letter-spacing: 0.08em;
}


.experience__description {
  max-width: 700px;

  margin-top: 28px;

  color:
    rgba(255, 255, 255, 0.5);

  font-size: 13px;

  line-height: 1.9;
}


/* ===================================
   RESPONSIBILITIES
=================================== */

.experience__responsibilities {
  max-width: 700px;

  margin: 30px 0 0;

  padding: 0;

  list-style: none;
}


.experience__responsibilities li {
  position: relative;

  padding:
    11px 0
    11px 24px;

  color:
    rgba(255, 255, 255, 0.62);

  font-size: 12px;

  line-height: 1.6;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.06);
}


.experience__responsibilities li::before {
  content: '→';

  position: absolute;

  left: 0;

  color: #d1a467;
}


/* ===================================
   TAGS
=================================== */

.experience__tags {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 30px;
}


.experience__tags span {
  padding: 7px 11px;

  color:
    rgba(255, 255, 255, 0.55);

  background:
    rgba(255, 255, 255, 0.035);

  border:
    1px solid rgba(255, 255, 255, 0.09);

  font-size: 9px;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}


/* ===================================
   TABLET
=================================== */

@media (max-width: 1000px) {

  .experience {
    padding: 110px 0 120px;
  }


  .experience__header {
    margin-bottom: 65px;
  }


  .experience__intro {
    gap: 60px;

    margin-bottom: 80px;
  }


  .experience__item {
    grid-template-columns:
      45px
      150px
      1fr;

    gap: 30px;
  }

}


/* ===================================
   MOBILE
=================================== */

@media (max-width: 768px) {

  .experience {
    padding: 90px 0;
  }


  .experience__container {
    width:
      min(100% - 32px, 1240px);
  }


  .experience__header {
    margin-bottom: 50px;
  }


  .experience__intro {
    display: block;

    margin-bottom: 65px;
  }


  .experience__intro-text {
    margin-top: 35px;
  }


  .experience__item {
    display: grid;

    grid-template-columns:
      40px 1fr;

    gap: 20px;

    padding: 40px 0;
  }


  .experience__period {
    grid-column: 2;

    margin-bottom: 10px;
  }


  .experience__content {
    grid-column: 2;
  }


  .experience__item:hover {
    padding-left: 0;
    padding-right: 0;

    background: none;
  }

}


/* ===================================
   SMALL MOBILE
=================================== */

@media (max-width: 480px) {

  .experience {
    padding: 75px 0 85px;
  }


  .experience__title {
    font-size: 48px;
  }


  .experience__item {
    grid-template-columns:
      30px 1fr;

    gap: 15px;
  }


  .experience__content h3 {
    font-size: 34px;
  }

}

</style>