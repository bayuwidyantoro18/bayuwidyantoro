---
import { projects } from '../../data/projects';
---

<section id="portfolio" class="portfolio">
  <div class="portfolio__container">

    <!-- SECTION HEADER -->

    <div class="portfolio__header">

      <span class="portfolio__number">
        04
      </span>

      <div class="portfolio__line"></div>

      <span class="portfolio__label">
        Portfolio
      </span>

    </div>


    <!-- INTRO -->

    <div class="portfolio__intro">

      <div>

        <p class="portfolio__eyebrow">
          SELECTED WORK
        </p>

        <h2 class="portfolio__title">
          Ideas turned
          <br />
          into solutions.
        </h2>

      </div>


      <div class="portfolio__intro-content">

        <p class="portfolio__lead">
          From administrative needs
          to <span>digital solutions.</span>
        </p>

        <p class="portfolio__intro-text">
          A selection of professional and personal projects
          focused on improving processes, managing information,
          and solving operational challenges through technology.
        </p>

      </div>

    </div>


    <!-- PROJECTS -->

    <div class="portfolio__list">

      {
        projects.map((project, index) => (

          <article
            class:list={[
                'project',
                project.featured &&
                'project--featured'
            ]}
            data-reveal="up"
            data-reveal-delay={
                String(
                (index % 2) * 100
                )
            }
            >

            <!-- IMAGE -->

            <div
            class="project__visual"
            data-reveal="scale"
            >

              {
                project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                    class="project__image"
                  />
                ) : (
                  <div class="project__placeholder">
                    {project.number}
                  </div>
                )
              }

              <div class="project__image-overlay"></div>


              <div class="project__visual-meta">

                <span>
                  {project.category}
                </span>

                <span>
                  {project.year}
                </span>

              </div>

            </div>


            <!-- CONTENT -->

            <div class="project__content">

              <div class="project__top">

                <span class="project__number">
                  {project.number}
                </span>

                <span class="project__category">
                  {project.category}
                </span>

              </div>


              <h3 class="project__title">
                {project.title}
              </h3>


              <p class="project__subtitle">
                {project.subtitle}
              </p>


              <p class="project__description">
                {project.description}
              </p>


              <div class="project__technologies">

                {
                  project.technologies.map(technology => (

                    <span>
                      {technology}
                    </span>

                  ))
                }

              </div>


              <div class="project__footer">

                <span class="project__year">
                  {project.year}
                </span>

                <span class="project__arrow">
                  ↗
                </span>

              </div>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>


<style>

/* ==================================
   PORTFOLIO
================================== */

.portfolio {
  position: relative;

  padding: 120px 0 140px;

  background: #090c0e;

  color: #ffffff;

  overflow: hidden;
}


/* ambient accent */

.portfolio::before {
  content: '';

  position: absolute;

  left: 20%;
  top: 250px;

  width: 800px;
  height: 800px;

  background:
    radial-gradient(
      circle,
      rgba(209, 164, 103, 0.035),
      transparent 70%
    );

  pointer-events: none;
}


/* ==================================
   CONTAINER
================================== */

.portfolio__container {
  position: relative;
  z-index: 2;

  width: min(100% - 48px, 1240px);

  margin: 0 auto;
}


/* ==================================
   SECTION HEADER
================================== */

.portfolio__header {
  display: flex;
  align-items: center;

  gap: 16px;

  margin-bottom: 80px;
}


.portfolio__number {
  color: #d1a467;

  font-size: 11px;

  letter-spacing: 0.15em;
}


.portfolio__line {
  width: 45px;
  height: 1px;

  background:
    rgba(209, 164, 103, 0.65);
}


.portfolio__label {
  color:
    rgba(255, 255, 255, 0.4);

  font-size: 10px;

  letter-spacing: 0.25em;

  text-transform: uppercase;
}


/* ==================================
   INTRO
================================== */

.portfolio__intro {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(320px, 0.7fr);

  align-items: end;

  gap: 100px;

  margin-bottom: 95px;
}


.portfolio__eyebrow {
  margin-bottom: 20px;

  color: #d1a467;

  font-size: 10px;

  letter-spacing: 0.3em;
}


.portfolio__title {
  margin: 0;

  color: #f8f8f6;

  font-family: var(--font-display);

  font-size:
    clamp(55px, 5vw, 80px);

  font-weight: 400;

  line-height: 0.94;

  letter-spacing: -0.04em;
}


.portfolio__intro-content {
  max-width: 500px;
}


.portfolio__lead {
  margin-bottom: 20px;

  font-family: var(--font-display);

  font-size:
    clamp(25px, 2.4vw, 34px);

  line-height: 1.15;

  color:
    rgba(255, 255, 255, 0.82);
}


.portfolio__lead span {
  color: #d1a467;
}


.portfolio__intro-text {
  color:
    rgba(255, 255, 255, 0.45);

  font-size: 13px;

  line-height: 1.9;
}


/* ==================================
   PROJECT LIST
================================== */

.portfolio__list {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 70px 35px;
}


/* ==================================
   PROJECT
================================== */

.project {
  position: relative;
}


/* stagger effect */

.project:nth-child(even) {
  margin-top: 90px;
}


/* ==================================
   VISUAL
================================== */

.project__visual {
  position: relative;

  aspect-ratio: 16 / 10;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #171b1f,
      #0e1114
    );

  border:
    1px solid rgba(255, 255, 255, 0.08);
}


.project__image {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter:
    saturate(0.75)
    brightness(0.72);

  transition:
    transform 0.7s ease,
    filter 0.7s ease;
}


.project:hover .project__image {
  transform: scale(1.035);

  filter:
    saturate(0.9)
    brightness(0.82);
}


.project__image-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      180deg,
      transparent 50%,
      rgba(5, 7, 9, 0.75) 100%
    );

  pointer-events: none;
}


/* fallback when image missing */

.project__placeholder {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  color:
    rgba(255, 255, 255, 0.08);

  font-family: var(--font-display);

  font-size: 150px;
}


/* visual metadata */

.project__visual-meta {
  position: absolute;

  z-index: 3;

  left: 24px;
  right: 24px;
  bottom: 20px;

  display: flex;
  justify-content: space-between;

  color:
    rgba(255, 255, 255, 0.62);

  font-size: 9px;

  letter-spacing: 0.13em;

  text-transform: uppercase;
}


/* ==================================
   CONTENT
================================== */

.project__content {
  padding-top: 27px;
}


.project__top {
  display: flex;
  align-items: center;

  gap: 15px;

  margin-bottom: 18px;
}


.project__number {
  color: #d1a467;

  font-size: 9px;

  letter-spacing: 0.15em;
}


.project__category {
  color:
    rgba(255, 255, 255, 0.3);

  font-size: 9px;

  letter-spacing: 0.15em;

  text-transform: uppercase;
}


.project__title {
  margin: 0;

  color: #f7f7f5;

  font-family: var(--font-display);

  font-size:
    clamp(32px, 3.2vw, 47px);

  font-weight: 400;

  line-height: 1;
}


.project__subtitle {
  margin-top: 9px;

  color: #d1a467;

  font-size: 10px;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}


.project__description {
  max-width: 520px;

  margin-top: 21px;

  color:
    rgba(255, 255, 255, 0.45);

  font-size: 12px;

  line-height: 1.8;
}


/* ==================================
   TECHNOLOGIES
================================== */

.project__technologies {
  display: flex;

  flex-wrap: wrap;

  gap: 7px;

  margin-top: 24px;
}


.project__technologies span {
  padding: 6px 9px;

  border:
    1px solid rgba(255, 255, 255, 0.09);

  color:
    rgba(255, 255, 255, 0.52);

  font-size: 8px;

  letter-spacing: 0.09em;

  text-transform: uppercase;
}


/* ==================================
   PROJECT FOOTER
================================== */

.project__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 28px;

  padding-top: 16px;

  border-top:
    1px solid rgba(255, 255, 255, 0.08);
}


.project__year {
  color:
    rgba(255, 255, 255, 0.28);

  font-size: 9px;

  letter-spacing: 0.12em;
}


.project__arrow {
  color: #d1a467;

  font-size: 22px;

  transition:
    transform 0.3s ease;
}


.project:hover .project__arrow {
  transform:
    translate(4px, -4px);
}


/* ==================================
   TABLET
================================== */

@media (max-width: 1000px) {

  .portfolio {
    padding: 105px 0 115px;
  }


  .portfolio__intro {
    gap: 60px;

    margin-bottom: 75px;
  }


  .portfolio__list {
    gap: 60px 28px;
  }


  .project:nth-child(even) {
    margin-top: 60px;
  }

}


/* ==================================
   MOBILE
================================== */

@media (max-width: 768px) {

  .portfolio {
    padding: 90px 0;
  }


  .portfolio__container {
    width:
      min(100% - 32px, 1240px);
  }


  .portfolio__header {
    margin-bottom: 50px;
  }


  .portfolio__intro {
    display: block;

    margin-bottom: 60px;
  }


  .portfolio__intro-content {
    margin-top: 35px;
  }


  .portfolio__list {
    grid-template-columns: 1fr;

    gap: 65px;
  }


  .project:nth-child(even) {
    margin-top: 0;
  }


  .project__title {
    font-size: 40px;
  }

}


/* ==================================
   SMALL MOBILE
================================== */

@media (max-width: 480px) {

  .portfolio {
    padding: 75px 0 85px;
  }


  .portfolio__title {
    font-size: 48px;
  }


  .project__visual {
    aspect-ratio: 4 / 3;
  }


  .project__visual-meta {
    left: 17px;
    right: 17px;
    bottom: 15px;
  }


  .project__title {
    font-size: 36px;
  }

}

</style>