---
import { projects } from '../../data/projects';
---
<section id="portfolio" class="portfolio-section" aria-labelledby="portfolio-heading">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal="up">
      <h2 id="portfolio-heading"><span>02</span> PORTFOLIO</h2>
      <p>A SELECTION OF PROJECTS I'VE WORKED ON</p>
    </div>
    <div class="portfolio-toolbar" data-reveal="up">
      <p>SELECTED WORK <span>({projects.length.toString().padStart(2, '0')})</span></p>
      <div class="portfolio-filters" role="group" aria-label="Filter portfolio projects">
        {['All', 'Internal System', 'Web Development', 'Automation'].map((filter) => (
          <button type="button" class:list={['filter-button', filter === 'All' && 'is-active']} data-filter={filter}>{filter}</button>
        ))}
      </div>
    </div>
    <div class="portfolio-grid">
      {projects.map((project, index) => (
        <article class="project-card" data-category={project.category} data-reveal="up" data-reveal-delay={`${Math.min(index % 3 * 80, 240)}`}>
          <button type="button" class="project-open" data-project-open={project.number} aria-label={`View details for ${project.title}`}>
            <span class="project-image">
              {project.image ? <img src={project.image} alt={`Preview of ${project.title}`} loading="lazy" decoding="async" /> : <span class="project-fallback">BW.</span>}
              <span class="project-cover"><span>VIEW PROJECT <span aria-hidden="true">↗</span></span></span>
            </span>
            <span class="project-meta"><span>{project.category}</span><span>{project.year}</span></span>
            <span class="project-title">{project.title}</span>
            <span class="project-subtitle">{project.subtitle}</span>
          </button>
        </article>
      ))}
    </div>
    <p class="portfolio-ending">DESIGNING USEFUL EXPERIENCES, ONE SYSTEM AT A TIME<span>.</span></p>
  </div>
</section>

{projects.map((project) => (
  <dialog id={`project-dialog-${project.number}`} class="project-dialog" aria-label={`${project.title} details`}>
    <div class="dialog-layout">
      <div class="dialog-image">{project.image && <img src={project.image} alt={`Screenshot of ${project.title}`} loading="lazy" />}</div>
      <div class="dialog-content">
        <button class="dialog-close" type="button" data-project-close aria-label="Close project details">×</button>
        <p class="overline">{project.category} / {project.year}</p>
        <h3>{project.title}</h3>
        <p class="dialog-subtitle">{project.subtitle}</p>
        <p class="dialog-description">{project.description}</p>
        <div class="dialog-tags">{project.technologies.map(technology => <span>{technology}</span>)}</div>
        <button class="dialog-back" type="button" data-project-close>← BACK TO PORTFOLIO</button>
      </div>
    </div>
  </dialog>
))}
<script>
  // Native <dialog> preserves keyboard escape and focus handling.
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  filterButtons.forEach(button => button.addEventListener('click', () => {
    const selected = button.dataset.filter;
    filterButtons.forEach(other => other.classList.toggle('is-active', other === button));
    cards.forEach(card => { card.hidden = selected !== 'All' && card.dataset.category !== selected; });
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach(button => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(`project-dialog-${button.dataset.projectOpen}`) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-project-close]').forEach(button => {
    button.addEventListener('click', () => button.closest('dialog')?.close());
  });
  document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach(dialog => {
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  });
</script>
