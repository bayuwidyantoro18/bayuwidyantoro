---
import {
  contactInfo,
  socialLinks
} from '../../data/contact';
---

<section
  id="contact"
  class="contact"
>
  <div class="contact__container">

    <!-- SECTION HEADER -->

    <div
    class="contact__header"
    data-reveal="up"
    >

      <span class="contact__number">
        06
      </span>

      <div class="contact__line"></div>

      <span class="contact__label">
        Contact
      </span>

    </div>


    <!-- MAIN -->

    <div class="contact__grid">

      <!-- LEFT -->

      <div
        class="contact__intro"
        data-reveal="up"
        >

        <p class="contact__eyebrow">
          LET'S CONNECT
        </p>

        <h2 class="contact__title">
          Have something
          <br />
          worth building?
        </h2>

        <p class="contact__description">
          Whether it is an opportunity, a digital project,
          a process that needs improvement, or simply a conversation —
          I am always open to meaningful connections.
        </p>

      </div>


      <!-- RIGHT -->

      <div
        class="contact__details"
        data-reveal="up"
        data-reveal-delay="120"
        >

        <span class="contact__small-title">
          SAY HELLO
        </span>


        <div class="contact__items">

          {
            contactInfo.map(item => (

              <a
                href={item.href}
                class="contact__item"
                target={
                  item.label === 'WhatsApp'
                    ? '_blank'
                    : undefined
                }
                rel={
                  item.label === 'WhatsApp'
                    ? 'noopener noreferrer'
                    : undefined
                }
              >

                <div>

                  <span class="contact__item-label">
                    {item.label}
                  </span>

                  <p>
                    {item.value}
                  </p>

                </div>


                <span class="contact__item-arrow">
                  ↗
                </span>

              </a>

            ))
          }

        </div>


        <!-- EMAIL CTA -->

        <a
          href="mailto:bayu.widyantoro24@gmail.com"
          class="contact__button"
        >

          <span>
            Send an Email
          </span>

          <span>
            ↗
          </span>

        </a>


        {
          socialLinks.length > 0 && (

            <div class="contact__social">

              {
                socialLinks.map(link => (

                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.name}

                    <span>
                      ↗
                    </span>
                  </a>

                ))
              }

            </div>

          )
        }

      </div>

    </div>


    <!-- LARGE STATEMENT -->

    <div
    class="contact__statement"
    data-reveal="up"
    >

      <span>
        PEOPLE
      </span>

      <span class="contact__statement-dot">
        ·
      </span>

      <span>
        PROCESS
      </span>

      <span class="contact__statement-dot">
        ·
      </span>

      <span class="contact__statement-highlight">
        TECHNOLOGY
      </span>

    </div>

  </div>
</section>


<style>

/* ====================================
   CONTACT
==================================== */

.contact {
  position: relative;

  padding: 120px 0 100px;

  background:
    linear-gradient(
      180deg,
      #0d1013 0%,
      #07090b 100%
    );

  color: #ffffff;

  overflow: hidden;
}


/* warm ambient glow */

.contact::before {
  content: '';

  position: absolute;

  width: 750px;
  height: 750px;

  left: -350px;
  bottom: -300px;

  background:
    radial-gradient(
      circle,
      rgba(209, 164, 103, 0.08),
      transparent 70%
    );

  pointer-events: none;
}


/* ====================================
   CONTAINER
==================================== */

.contact__container {
  position: relative;

  z-index: 2;

  width: min(100% - 48px, 1240px);

  margin: 0 auto;
}


/* ====================================
   HEADER
==================================== */

.contact__header {
  display: flex;
  align-items: center;

  gap: 16px;

  margin-bottom: 90px;
}


.contact__number {
  color: #d1a467;

  font-size: 11px;

  letter-spacing: 0.15em;
}


.contact__line {
  width: 45px;
  height: 1px;

  background:
    rgba(209, 164, 103, 0.65);
}


.contact__label {
  color:
    rgba(255, 255, 255, 0.4);

  font-size: 10px;

  letter-spacing: 0.25em;

  text-transform: uppercase;
}


/* ====================================
   GRID
==================================== */

.contact__grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(360px, 0.75fr);

  gap: 120px;
}


/* ====================================
   INTRO
==================================== */

.contact__eyebrow {
  margin-bottom: 20px;

  color: #d1a467;

  font-size: 10px;

  letter-spacing: 0.3em;
}


.contact__title {
  max-width: 700px;

  margin: 0;

  color: #f8f8f6;

  font-family: var(--font-display);

  font-size:
    clamp(57px, 5.8vw, 90px);

  font-weight: 400;

  line-height: 0.92;

  letter-spacing: -0.045em;
}


.contact__description {
  max-width: 540px;

  margin-top: 35px;

  color:
    rgba(255, 255, 255, 0.44);

  font-size: 13px;

  line-height: 1.9;
}


/* ====================================
   DETAILS
==================================== */

.contact__details {
  padding-top: 20px;
}


.contact__small-title {
  display: block;

  margin-bottom: 30px;

  color:
    rgba(255, 255, 255, 0.3);

  font-size: 9px;

  letter-spacing: 0.22em;
}


.contact__items {
  border-top:
    1px solid rgba(255, 255, 255, 0.1);
}


.contact__item {
  display: flex;
  align-items: center;
  justify-content: space-between;

  min-height: 90px;

  gap: 30px;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.1);

  transition:
    padding 0.3s ease,
    background 0.3s ease;
}


.contact__item:hover {
  padding-left: 12px;
  padding-right: 12px;

  background:
    rgba(255, 255, 255, 0.018);
}


.contact__item-label {
  display: block;

  margin-bottom: 6px;

  color: #d1a467;

  font-size: 8px;

  letter-spacing: 0.17em;

  text-transform: uppercase;
}


.contact__item p {
  margin: 0;

  color:
    rgba(255, 255, 255, 0.77);

  font-size: 13px;
}


.contact__item-arrow {
  color: #d1a467;

  font-size: 22px;

  transition:
    transform 0.3s ease;
}


.contact__item:hover
.contact__item-arrow {
  transform:
    translate(4px, -4px);
}


/* ====================================
   BUTTON
==================================== */

.contact__button {
  width: 100%;

  min-height: 62px;

  margin-top: 35px;

  padding: 0 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: #111111;

  background: #d1a467;

  font-size: 11px;

  letter-spacing: 0.05em;

  transition:
    background 0.3s ease,
    transform 0.3s ease;
}


.contact__button:hover {
  background: #e0ba84;

  transform:
    translateY(-2px);
}


.contact__button span:last-child {
  font-size: 22px;
}


/* ====================================
   SOCIAL
==================================== */

.contact__social {
  display: flex;

  gap: 25px;

  margin-top: 30px;
}


.contact__social a {
  display: flex;
  align-items: center;

  gap: 8px;

  color:
    rgba(255, 255, 255, 0.4);

  font-size: 10px;

  transition: color 0.3s ease;
}


.contact__social a:hover {
  color: #ffffff;
}


.contact__social span {
  color: #d1a467;
}


/* ====================================
   STATEMENT
==================================== */

.contact__statement {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 18px;

  margin-top: 130px;

  padding-top: 50px;

  border-top:
    1px solid rgba(255, 255, 255, 0.1);

  color:
    rgba(255, 255, 255, 0.12);

  font-family: var(--font-display);

  font-size:
    clamp(36px, 5vw, 72px);

  line-height: 1;
}


.contact__statement-dot {
  color:
    rgba(209, 164, 103, 0.4);
}


.contact__statement-highlight {
  color:
    rgba(255, 255, 255, 0.72);
}


/* ====================================
   TABLET
==================================== */

@media (max-width: 1000px) {

  .contact {
    padding: 105px 0 90px;
  }


  .contact__grid {
    gap: 70px;
  }


  .contact__title {
    font-size:
      clamp(55px, 7vw, 75px);
  }

}


/* ====================================
   MOBILE
==================================== */

@media (max-width: 768px) {

  .contact {
    padding: 90px 0 75px;
  }


  .contact__container {
    width:
      min(100% - 32px, 1240px);
  }


  .contact__header {
    margin-bottom: 50px;
  }


  .contact__grid {
    display: block;
  }


  .contact__details {
    margin-top: 65px;

    padding-top: 0;
  }


  .contact__statement {
    margin-top: 90px;

    gap: 12px;
  }

}


/* ====================================
   SMALL MOBILE
==================================== */

@media (max-width: 480px) {

  .contact {
    padding: 75px 0 70px;
  }


  .contact__title {
    font-size: 50px;
  }


  .contact__description {
    font-size: 12px;
  }


  .contact__item p {
    font-size: 12px;
  }


  .contact__statement {
    font-size: 35px;
  }

}

</style>