---
import { softwareProficiency } from '../../data/proficiency';
import { skillGroups } from '../../data/skills';
---
<section id="professional" class="professional-section" aria-labelledby="professional-heading">
  <div class="section-grid" aria-hidden="true"></div>
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal="up">
      <h2 id="professional-heading"><span>01</span> PROFESSIONAL</h2>
      <p>THE INTERSECTION OF PEOPLE, PROCESS &amp; TECHNOLOGY</p>
    </div>
    <div class="professional-layout">
      <div class="professional-intro" data-reveal="left">
        <span class="professional-initial" aria-hidden="true">B<span>.</span></span>
        <span class="overline">A LITTLE ABOUT ME</span>
        <h3>Practical thinking.<br /><strong>Digital solutions.</strong></h3>
        <p>I'm Bayu, a Human Capital professional with more than eight years of experience in HR, General Affairs, payroll, employee administration, and documentation.</p>
        <p>Alongside my HR background, I build and maintain websites and internal systems. I enjoy turning complex, manual processes into experiences that are simpler, more efficient, and more useful for people.</p>
        <a href="#experience" class="text-link">MORE ABOUT MY EXPERIENCE <span aria-hidden="true">↗</span></a>
      </div>
      <div class="professional-skills" data-reveal="right" data-reveal-delay="100">
        <div class="skills-header">
          <h3>MY KNOWLEDGE LEVEL IN SOFTWARE</h3>
          <span>SELF-ASSESSMENT</span>
        </div>
        <div class="skill-bars">
          {softwareProficiency.map((item, i) => (
            <div class="skill-bar" style={`--bar-width: ${item.percent}%; --bar-delay: ${i * 70}ms`}>
              <div class="skill-bar-top"><span>{item.name}</span><span>{item.percent}%</span></div>
              <div class="skill-track" role="meter" aria-label={item.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={item.percent}>
                <span class="skill-fill"></span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="expertise-strip" data-reveal="up">
      {skillGroups.map((group, index) => (
        <div class="expertise-item">
          <span>0{index + 1}</span>
          <h3>{group.title}</h3>
          <p>{group.skills.slice(0, 3).join(' · ')}</p>
        </div>
      ))}
    </div>
  </div>
</section>
