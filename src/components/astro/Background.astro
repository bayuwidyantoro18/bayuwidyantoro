---
import { education, professionalHighlights, certifications } from '../../data/background';
---
<section class="background-section" id="background" aria-labelledby="background-heading">
  <div class="container">
    <div class="background-heading" data-reveal="up">
      <p class="overline">BEYOND THE JOB TITLE</p>
      <h2 id="background-heading">ALWAYS<br /> <span>LEARNING.</span></h2>
      <p>Great work comes from a willingness to keep growing. A few milestones from my educational and professional journey.</p>
    </div>
    <div class="background-grid">
      <div class="background-panel" data-reveal="up">
        <h3><span>01 /</span> EDUCATION</h3>
        {education.map(entry => (
          <div class="background-item">
            <span class="background-period">{entry.period}</span>
            <h4>{entry.institution}</h4>
            <p>{entry.degree} · {entry.field}</p>
            {entry.detail && <small>{entry.detail}</small>}
          </div>
        ))}
      </div>
      <div class="background-panel" data-reveal="up" data-reveal-delay="80">
        <h3><span>02 /</span> HIGHLIGHTS</h3>
        {professionalHighlights.map(entry => (
          <div class="background-item">
            <span class="background-period">{entry.year} · {entry.role}</span>
            <h4>{entry.title}</h4>
            <p>{entry.organization}</p>
          </div>
        ))}
      </div>
      <div class="background-panel" data-reveal="up" data-reveal-delay="160">
        <h3><span>03 /</span> CERTIFICATIONS</h3>
        {certifications.map(entry => (
          <div class="background-item background-item--compact">
            <span class="background-period">{entry.year}</span>
            <h4>{entry.title}</h4>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
