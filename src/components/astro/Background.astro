---
import {
  education,
  professionalHighlights,
  certifications
} from '../../data/background';
---

<section id="background" class="background">
  <div class="background__container">

    <!-- SECTION HEADER -->

    <div
    class="background__header"
    data-reveal="up"
    >
      <span class="background__number">05</span>

      <div class="background__line"></div>

      <span class="background__label">
        Background
      </span>
    </div>


    <!-- INTRO -->

    <div
    class="background__intro"
    data-reveal="up"
    >

      <div>
        <p class="background__eyebrow">
          EDUCATION & PROFESSIONAL JOURNEY
        </p>

        <h2 class="background__title">
          Beyond
          <br />
          the work.
        </h2>
      </div>


      <p class="background__intro-text">
        Education, professional involvement, and continuous learning
        have shaped the way I approach people, processes,
        and technology.
      </p>

    </div>


    <!-- EDUCATION + HIGHLIGHTS -->

    <div class="background__main">

      <!-- EDUCATION -->

      <div
        class="background__column"
        data-reveal="up"
        >

        <div class="background__column-header">
          <span>01</span>
          <h3>Education</h3>
        </div>

        <div class="education">

          {
            education.map(item => (

              <article class="education__item">

                <span class="education__period">
                  {item.period}
                </span>

                <h4>
                  {item.institution}
                </h4>

                <span class="education__location">
                  {item.location}
                </span>

                <p class="education__degree">
                  {item.degree}
                </p>

                <p class="education__field">
                  {item.field}
                </p>

                {
                  item.detail && (
                    <p class="education__detail">
                      {item.detail}
                    </p>
                  )
                }

              </article>

            ))
          }

        </div>

      </div>


      <!-- PROFESSIONAL HIGHLIGHTS -->

      <div
        class="background__column"
        data-reveal="up"
        data-reveal-delay="120"
        >

        <div class="background__column-header">
          <span>02</span>
          <h3>Professional Highlights</h3>
        </div>

        <div class="highlights">

          {
            professionalHighlights.map(item => (

              <article class="highlight">

                <div class="highlight__year">
                  {item.year}
                </div>

                <div class="highlight__content">

                  <span class="highlight__role">
                    {item.role}
                  </span>

                  <h4>
                    {item.title}
                  </h4>

                  <p class="highlight__organization">
                    {item.organization}
                  </p>

                  <p class="highlight__description">
                    {item.description}
                  </p>

                </div>

              </article>

            ))
          }

        </div>

      </div>

    </div>


    <!-- CERTIFICATIONS -->

    <div
    class="certifications"
    data-reveal="up"
    >

      <div class="certifications__heading">

        <div>
          <span>03</span>

          <h3>
            Selected Certifications
          </h3>
        </div>

        <p>
          Continuous learning across Human Capital,
          technology, compliance, and digital transformation.
        </p>

      </div>


      <div class="certifications__grid">

        {
          certifications.map(item => (

            <article class="certification">

              <div class="certification__year">
                {item.year}
              </div>

              <h4>
                {item.title}
              </h4>

              <span>
                {item.category}
              </span>

            </article>

          ))
        }

      </div>

    </div>

  </div>
</section>


<style>

/* ==============================
   SECTION
============================== */

.background {
  position: relative;

  padding: 120px 0 135px;

  background:
    linear-gradient(
      180deg,
      #090c0e 0%,
      #0d1013 100%
    );

  color: #ffffff;

  overflow: hidden;
}


.background::before {
  content: '';

  position: absolute;

  right: -250px;
  top: 200px;

  width: 650px;
  height: 650px;

  background:
    radial-gradient(
      circle,
      rgba(209, 164, 103, 0.05),
      transparent 70%
    );

  pointer-events: none;
}


/* ==============================
   CONTAINER
============================== */

.background__container {
  position: relative;

  z-index: 2;

  width: min(100% - 48px, 1240px);

  margin: 0 auto;
}


/* ==============================
   HEADER
============================== */

.background__header {
  display: flex;
  align-items: center;

  gap: 16px;

  margin-bottom: 80px;
}


.background__number {
  color: #d1a467;

  font-size: 11px;

  letter-spacing: 0.15em;
}


.background__line {
  width: 45px;
  height: 1px;

  background:
    rgba(209, 164, 103, 0.65);
}


.background__label {
  color:
    rgba(255, 255, 255, 0.4);

  font-size: 10px;

  letter-spacing: 0.25em;

  text-transform: uppercase;
}


/* ==============================
   INTRO
============================== */

.background__intro {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(320px, 0.7fr);

  align-items: end;

  gap: 100px;

  margin-bottom: 90px;
}


.background__eyebrow {
  margin-bottom: 20px;

  color: #d1a467;

  font-size: 10px;

  letter-spacing: 0.3em;
}


.background__title {
  margin: 0;

  color: #f8f8f6;

  font-family: var(--font-display);

  font-size:
    clamp(55px, 5vw, 80px);

  font-weight: 400;

  line-height: 0.94;

  letter-spacing: -0.04em;
}


.background__intro-text {
  max-width: 470px;

  color:
    rgba(255, 255, 255, 0.45);

  font-size: 13px;

  line-height: 1.9;
}


/* ==============================
   MAIN GRID
============================== */

.background__main {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 80px;

  padding-top: 45px;

  border-top:
    1px solid rgba(255, 255, 255, 0.1);
}


.background__column-header {
  display: flex;
  align-items: center;

  gap: 15px;

  margin-bottom: 45px;
}


.background__column-header span,
.certifications__heading span {
  color: #d1a467;

  font-size: 9px;

  letter-spacing: 0.15em;
}


.background__column-header h3,
.certifications__heading h3 {
  margin: 0;

  color:
    rgba(255, 255, 255, 0.65);

  font-size: 11px;

  font-weight: 400;

  letter-spacing: 0.16em;

  text-transform: uppercase;
}


/* ==============================
   EDUCATION
============================== */

.education__item {
  position: relative;

  padding:
    0 0 45px 30px;

  border-left:
    1px solid rgba(255, 255, 255, 0.12);
}


.education__item:last-child {
  padding-bottom: 0;
}


.education__item::before {
  content: '';

  position: absolute;

  left: -4px;
  top: 5px;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #d1a467;
}


.education__period {
  display: block;

  margin-bottom: 12px;

  color: #d1a467;

  font-size: 9px;

  letter-spacing: 0.14em;
}


.education__item h4 {
  margin: 0;

  color: #f8f8f6;

  font-family: var(--font-display);

  font-size: 30px;

  font-weight: 400;
}


.education__location {
  display: block;

  margin-top: 4px;

  color:
    rgba(255, 255, 255, 0.35);

  font-size: 10px;
}


.education__degree {
  margin-top: 15px;

  color:
    rgba(255, 255, 255, 0.65);

  font-size: 12px;
}


.education__field {
  margin-top: 3px;

  color:
    rgba(255, 255, 255, 0.48);

  font-size: 12px;
}


.education__detail {
  display: inline-block;

  margin-top: 13px;

  padding: 6px 9px;

  color: #d1a467;

  border:
    1px solid rgba(209, 164, 103, 0.25);

  font-size: 9px;

  letter-spacing: 0.08em;
}


/* ==============================
   PROFESSIONAL HIGHLIGHTS
============================== */

.highlight {
  display: grid;

  grid-template-columns:
    65px 1fr;

  gap: 25px;

  padding: 0 0 32px;

  margin-bottom: 32px;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.08);
}


.highlight__year {
  padding-top: 5px;

  color: #d1a467;

  font-size: 10px;

  letter-spacing: 0.12em;
}


.highlight__role {
  color:
    rgba(255, 255, 255, 0.35);

  font-size: 9px;

  letter-spacing: 0.13em;

  text-transform: uppercase;
}


.highlight h4 {
  margin: 7px 0 0;

  color: #f8f8f6;

  font-family: var(--font-display);

  font-size: 27px;

  font-weight: 400;
}


.highlight__organization {
  margin-top: 7px;

  color:
    rgba(255, 255, 255, 0.52);

  font-size: 11px;
}


.highlight__description {
  max-width: 480px;

  margin-top: 14px;

  color:
    rgba(255, 255, 255, 0.38);

  font-size: 11px;

  line-height: 1.75;
}


/* ==============================
   CERTIFICATIONS
============================== */

.certifications {
  margin-top: 110px;

  padding-top: 50px;

  border-top:
    1px solid rgba(255, 255, 255, 0.1);
}


.certifications__heading {
  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 40px;

  margin-bottom: 45px;
}


.certifications__heading > div {
  display: flex;
  align-items: center;

  gap: 15px;
}


.certifications__heading p {
  max-width: 400px;

  color:
    rgba(255, 255, 255, 0.35);

  font-size: 11px;

  line-height: 1.7;
}


.certifications__grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  border-top:
    1px solid rgba(255, 255, 255, 0.09);

  border-left:
    1px solid rgba(255, 255, 255, 0.09);
}


.certification {
  min-height: 190px;

  padding: 28px;

  border-right:
    1px solid rgba(255, 255, 255, 0.09);

  border-bottom:
    1px solid rgba(255, 255, 255, 0.09);

  transition: background 0.3s ease;
}


.certification:hover {
  background:
    rgba(255, 255, 255, 0.02);
}


.certification__year {
  margin-bottom: 25px;

  color: #d1a467;

  font-size: 9px;

  letter-spacing: 0.15em;
}


.certification h4 {
  margin: 0;

  color:
    rgba(255, 255, 255, 0.78);

  font-size: 12px;

  font-weight: 400;

  line-height: 1.6;
}


.certification span {
  display: block;

  margin-top: 17px;

  color:
    rgba(255, 255, 255, 0.28);

  font-size: 8px;

  letter-spacing: 0.12em;

  text-transform: uppercase;
}


/* ==============================
   TABLET
============================== */

@media (max-width: 1000px) {

  .background {
    padding: 105px 0 115px;
  }


  .background__intro {
    gap: 60px;
  }


  .background__main {
    gap: 50px;
  }


  .certifications__grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* ==============================
   MOBILE
============================== */

@media (max-width: 768px) {

  .background {
    padding: 90px 0;
  }


  .background__container {
    width:
      min(100% - 32px, 1240px);
  }


  .background__header {
    margin-bottom: 50px;
  }


  .background__intro {
    display: block;

    margin-bottom: 65px;
  }


  .background__intro-text {
    margin-top: 35px;
  }


  .background__main {
    grid-template-columns: 1fr;

    gap: 80px;
  }


  .certifications {
    margin-top: 80px;
  }


  .certifications__heading {
    display: block;
  }


  .certifications__heading p {
    margin-top: 20px;
  }


  .certifications__grid {
    grid-template-columns: 1fr;
  }


  .certification {
    min-height: auto;
  }

}


/* ==============================
   SMALL MOBILE
============================== */

@media (max-width: 480px) {

  .background {
    padding: 75px 0 85px;
  }


  .background__title {
    font-size: 48px;
  }


  .education__item h4 {
    font-size: 26px;
  }


  .highlight {
    grid-template-columns:
      50px 1fr;

    gap: 15px;
  }

}

</style>