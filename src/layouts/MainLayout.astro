---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bayu Widyantoro | Personal Portfolio',
  description = 'Personal website dan portfolio Bayu Widyantoro.'
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content={description}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />

	<script>
	import '../scripts/reveal';
	</script>

  </body>
</html>